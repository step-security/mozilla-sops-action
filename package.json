{
   "name": "mozilla-sops-action",
   "version": "2.1.2",
   "private": true,
   "type": "module",
   "description": "GitHub Action to install a specific version of the SOPS binary",
   "author": "step-security",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/step-security/mozilla-sops-action.git"
   },
   "dependencies": {
      "@actions/core": "^3.0.1",
      "@actions/tool-cache": "^4.0.0",
      "axios": "^1.20.0"
   },
   "main": "dist/index.js",
   "scripts": {
      "build": "tsc -p tsconfig.build.json && rollup -c",
      "typecheck": "tsc --noEmit",
      "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
      "test-coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
      "format": "prettier --write .",
      "format-check": "prettier --check ."
   },
   "devDependencies": {
      "@jest/globals": "^30.5.2",
      "@rollup/plugin-commonjs": "^29.0.3",
      "@rollup/plugin-json": "^6.1.0",
      "@rollup/plugin-node-resolve": "^16.0.3",
      "@types/node": "^26.6.4",
      "jest": "^30.5.2",
      "prettier": "^3.9.9",
      "rollup": "^4.64.0",
      "typescript": "^7.0.2"
   }
}
